# Copy to .env.local for development. Never commit real values.
# On Vercel, add GEMINI_API_KEY under Settings -> Environment Variables.

# Required for the AI assistant. A free key from https://aistudio.google.com/apikey
# Use a key from its own Google project, so the assistant has its own free quota.
GEMINI_API_KEY=

# Optional: models tried in order (the second is the fallback)
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: send contact messages online through Formspree instead of the mail app
# VITE_FORMSPREE_ID=
